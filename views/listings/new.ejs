<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <br>
    <h3>Create a new Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">title empty</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" placeholder="enter description" cols="10" rows="3" class="form-control" required></textarea>
            <div class="invalid-feedback">write a description</div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Upload Image</label>
            <input name="image" type="file" class="form-control" required>
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" placeholder="$" class="form-control" required>
            <div class="invalid-feedback">enter correct amount</div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" placeholder="United States" type="text" class="form-control" required>
            <div class="invalid-feedback">invalid country name</div>
        </div>
        </div>    
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" placeholder="Los Angeles" type="text" class="form-control" required>
            <div class="invalid-feedback">enter location</div>
        </div> 
        <button class="btn btn-dark add-btn mt-3">Add</button> 
    </form>
    </div>
</div>